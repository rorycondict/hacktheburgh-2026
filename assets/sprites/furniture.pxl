# Furniture, 16x16 with transparent background ('.'). One per FurnitureDto.kind.

# DESK (source file), screen on: the agent has touched this file.
@sprite obj_desk
................
...KKKKKKKKKK...
...KiiiiiiiiK...
...KiIIIiiiiK...
...KiiIIIIiiK...
...KiIIiiiiiK...
...KKKKKKKKKK...
.......KK.......
.KKKKKKKKKKKKKK.
.KyyyyyyyyyyyyK.
.KyyyLLLLLLyyyK.
.KooooooooooooK.
.KKKKKKKKKKKKKK.
.KNNNKNNNNKNNNK.
.KNNNKNNNNKNNNK.
.KKKKKKKKKKKKKK.

# Screen off: not touched yet.
@recolor obj_desk_off from obj_desk i=k I=g

# Screen red: the agent's last tool call on this file failed.
@recolor obj_desk_error from obj_desk i=r I=R

