<idea-plugin>
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="htb.shared"/>
        <plugin id="com.intellij.mcpServer"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <platform.rpc.backend.remoteApiProvider implementation="com.example.BackendRpcApiProvider"/>
        <postStartupActivity implementation="com.example.backend.FloorplanStartupActivity"/>
    </extensions>

    <!-- Tools the agent calls (through the IDE's built-in MCP server) to design the map. -->
    <extensions defaultExtensionNs="com.intellij.mcpServer">
        <mcpToolset implementation="com.example.backend.mcp.FloorplanToolset"/>
    </extensions>
</idea-plugin>
